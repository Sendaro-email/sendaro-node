{
  "name": "sendaro",
  "version": "0.2.0",
  "description": "Official Node.js and TypeScript SDK for Sendaro, the transactional email API",
  "type": "module",
  "license": "MIT",
  "homepage": "https://sendaro.email/docs#sending",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sendaro-email/sendaro-node.git"
  },
  "bugs": {
    "url": "https://github.com/Sendaro-email/sendaro-node/issues"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "sendaro",
    "email",
    "transactional-email",
    "email-api",
    "smtp",
    "ses",
    "typescript"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
